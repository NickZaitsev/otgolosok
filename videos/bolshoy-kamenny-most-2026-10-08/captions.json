[
  {
    "start": 0.12,
    "end": 2.29,
    "text": "Прогулка пройдёт от Кропоткинской через"
  },
  {
    "start": 2.29,
    "end": 4.64,
    "text": "остров между Москвой-рекой и Водоотводным"
  },
  {
    "start": 4.64,
    "end": 6.36,
    "text": "каналом к Новокузнецкой."
  },
  {
    "start": 6.48,
    "end": 8.87,
    "text": "По дороге будут купеческие палаты, большой"
  },
  {
    "start": 8.87,
    "end": 12.07,
    "text": "жилой комплекс, гостиничные фасады и старые"
  },
  {
    "start": 12.15,
    "end": 15.41,
    "text": "храмы. Начинаем на Большом Каменном мосту."
  },
  {
    "start": 15.5,
    "end": 17.75,
    "text": "Рассказ слушаем на тротуаре, не выходя на"
  },
  {
    "start": 17.75,
    "end": 19.23,
    "text": "проезжую часть."
  },
  {
    "start": 19.44,
    "end": 21.49,
    "text": "Посещения музеев и входа в закрытые дворы"
  },
  {
    "start": 21.49,
    "end": 23.11,
    "text": "маршрут не требует."
  },
  {
    "start": 23.19,
    "end": 25.68,
    "text": "Название Большого Каменного моста хранит"
  },
  {
    "start": 25.68,
    "end": 27.59,
    "text": "память о старой переправе."
  },
  {
    "start": 27.59,
    "end": 30.09,
    "text": "В XVII веке постоянный мост должен был"
  },
  {
    "start": 30.09,
    "end": 32.47,
    "text": "заменить наплавные сооружения, которые"
  },
  {
    "start": 32.48,
    "end": 35.16,
    "text": "приходилось разбирать во время половодья."
  },
  {
    "start": 35.29,
    "end": 38.15,
    "text": "Первую попытку предприняли в 1643"
  },
  {
    "start": 38.15,
    "end": 41.3,
    "text": "году, пригласив мастера Анце Кристлера;"
  },
  {
    "start": 41.41,
    "end": 44.3,
    "text": "закончить строительство удалось лишь в"
  },
  {
    "start": 44.3,
    "end": 46.08,
    "text": "1687 году."
  },
  {
    "start": 46.2,
    "end": 48.67,
    "text": "На старом мосту стояли торговые лавки, а со"
  },
  {
    "start": 48.67,
    "end": 51.32,
    "text": "стороны Замоскворечья возвышалась башня с"
  },
  {
    "start": 51.32,
    "end": 54.57,
    "text": "воротами. После обрушения нескольких арок в"
  },
  {
    "start": 54.57,
    "end": 57.57,
    "text": "1783 году при ремонте лавки и башню"
  },
  {
    "start": 57.57,
    "end": 60.47,
    "text": "разобрали. В XIX веке переправу заменил"
  },
  {
    "start": 60.55,
    "end": 63.32,
    "text": "мост с металлическими фермами."
  },
  {
    "start": 63.45,
    "end": 66.48,
    "text": "Современный мост открыли в 1938"
  },
  {
    "start": 66.56,
    "end": 69.11,
    "text": "году ниже по течению: его направили к"
  },
  {
    "start": 69.21,
    "end": 71.68,
    "text": "новому проезду вместо узкой Ленивки."
  },
  {
    "start": 71.8,
    "end": 74.03,
    "text": "Перестройка московских мостов была связана"
  },
  {
    "start": 74.03,
    "end": 76.14,
    "text": "с появлением канала Москва — Волга и"
  },
  {
    "start": 76.14,
    "end": 78.83,
    "text": "необходимостью пропускать более крупные"
  },
  {
    "start": 78.89,
    "end": 79.24,
    "text": "суда."
  }
]
