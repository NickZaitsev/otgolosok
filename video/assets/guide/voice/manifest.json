    "durationSeconds": 4.992,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "settings-do": {
    "key": "9bf24002c6ccc9235e4cd25eb52c5caea380ad4507b313ab6819598e0d8cab6a",
    "text": "Кнопка с ползунками открывает настройки прогулки.",
