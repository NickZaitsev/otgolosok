    "durationSeconds": 3.936,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "settings-done": {
    "key": "df3d457e8cd6b91e0c2b34be01ed4869f6cc7387cf90ef8ce34a04cb1ca21398",
    "text": "Здесь выбирают, как переключаются остановки, и меняют скорость аудио.",
    "sha256": "7cd37ee293a2a86b819033d3896a2991db3a032659aa060faaf849d6ed913ca2",
    "durationSeconds": 5.352,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "stops-do": {
