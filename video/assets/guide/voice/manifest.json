    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "read-do": {
    "key": "f3bfecc1f5083ba37d544c485107a36df19b3ed5b09029ee90ca5d6fb628e08f",
    "text": "Хотите читать, а не слушать? Нажмите «Читать историю».",
