{
  "intro": {
    "key": "09a13f60f0f531aac10d64cb88e9d80c960fca04e7954ebdd860f399e6fa8bb4",
    "text": "Как гулять с Отголоском. Покажем весь путь: от выбора маршрута до следующей истории.",
    "sha256": "905b3730cdedb82febe4d9471cfab37f67e99bdab3020baee611abaac40cfcab",
    "durationSeconds": 6.408,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "home-do": {
    "key": "3fa291c9850e5739fefa61561aa4e81d7f66c669aee66c6927de36c3309fb295",
    "text": "Откройте раздел «История» в нижнем меню.",
    "sha256": "b34d45f65d238327a190687ac4bb20a2baa6026df0bce81ec12a5afb2d37cb28",
    "durationSeconds": 3.192,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "home-done": {
    "key": "6a33e3851f6e790d9c9c0711d9f63e05bcf1122cbaa4f3167f9785d7da9c5306",
    "text": "Здесь хранятся ваши прогулки и готовые маршруты.",
    "sha256": "e012446293b1d5803c7a89cea380187caed0502cd28f6f01944b209232f955b9",
    "durationSeconds": 3.888,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "catalog-do": {
    "key": "ba7f30f38eccb7d1c12d8674bc3954e8951346f24edff17a746e1819fdd16757",
    "text": "Прокрутите вниз, к готовому маршруту, и нажмите «Открыть прогулку».",
    "sha256": "16bbc171ad933c075be918cbd7d3d559da7a26133175e6f7a05fc1133b404a52",
    "durationSeconds": 5.112,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "catalog-done": {
    "key": "2f2f0c1d7e3e88606bffc9d3e9b0c740b01a7803818518b5f09c3c9eb8b20008",
    "text": "Откроется карта с путём и остановками.",
    "sha256": "80ff248858267d57ef941d1bac6dc1e93e4e97592de670199b0c263add349624",
    "durationSeconds": 3.12,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "start-do": {
    "key": "a44b9e08e78bf36f86124a67c5a972975f28233e0e101b59a45e31679cdbb92c",
    "text": "Посмотрите маршрут целиком и нажмите «Начать прогулку».",
    "sha256": "cb0418c05ed0113906dcec1aaaebfce63ca633352e4e1064d8c5b20938ebb707",
    "durationSeconds": 4.344,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "start-done": {
    "key": "8dcbc780c0366326e3e9a42cec0f342c7be3bc1539e317f50a6d7156b2682a36",
    "text": "Появится первая остановка, и зазвучит рассказ.",
    "sha256": "7242ebeaa387d0d37f2d42848d6f939e0dfd36cd32beb907ed9608658820c95b",
    "durationSeconds": 3.72,
    "profile": "f5-ru-v1",
    "voice": "obrazec6"
  },
  "pause-do": {
