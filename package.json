{
  "name": "otgolosok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "node scripts/build-walk-catalog.mjs && node scripts/build-map.mjs && next build && node scripts/build-content-security-policy.mjs && node scripts/build-service-worker.mjs",
    "start": "serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json && pnpm --filter @otgolosok/video run typecheck",
    "test": "vitest run && node --test backend/*.test.mjs && pnpm --filter @otgolosok/video run test",
    "test:py": "uv run ruff check . && uv run pyright && uv run pytest -q",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:py && pnpm build",
    "generator:dev": "STATIC_DIR=out node backend/server.mjs",
    "auth:set-editor": "node scripts/set-editor.mjs",
    "test:e2e": "playwright test",
    "video:prepare": "pnpm --filter @otgolosok/video run assets",
    "video:studio": "pnpm --filter @otgolosok/video run studio",
    "video:render": "pnpm --filter @otgolosok/video run render",
    "video:render:ad": "pnpm --filter @otgolosok/video run render:ad",
    "video:render:motion": "pnpm --filter @otgolosok/video run render:motion",
    "video:render:create-ad": "pnpm --filter @otgolosok/video run render:create-ad",
    "video:render:motion-wide": "pnpm --filter @otgolosok/video run render:motion-wide",
    "video:render:motion-centre": "pnpm --filter @otgolosok/video run render:motion-centre",
    "video:render:centre-vertical": "pnpm --filter @otgolosok/video run render:centre-vertical",
    "video:centre:data": "pnpm --filter @otgolosok/video run centre:data",
    "video:render:kinetic": "pnpm --filter @otgolosok/video run render:kinetic",
    "video:preview:kinetic": "pnpm --filter @otgolosok/video run preview:kinetic",
    "video:data:red-square": "pnpm --filter @otgolosok/video run data:red-square",
    "video:render:red-square": "pnpm --filter @otgolosok/video run render:red-square",
    "video:preview:red-square": "pnpm --filter @otgolosok/video run preview:red-square",
    "video:voice:red-square": "pnpm --filter @otgolosok/video run voice:red-square",
    "video:render:guide": "pnpm --filter @otgolosok/video run render:guide",
    "video:render:create-guide": "pnpm --filter @otgolosok/video run render:create-guide",
    "video:voice": "pnpm --filter @otgolosok/video run voice"
  },
  "dependencies": {
    "@softmg/airouter-logs": "file:vendor/softmg-airouter-logs-0.1.0.tgz",
    "better-auth": "1.7.5",
    "leaflet": "1.9.4",
    "next": "16.3.4",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "serve": "14.2.6",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
